<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Silk Pack</title>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="icon" href="/img/favicon.png">
</head>
<body>
    <div class="struct toEnd">
        <div class="row centered">
            <div class="col">
                <div class="col spe">
                    <h1>Silk Pack</h1>
                    <h5>As soft as the silk,<br>build your own web</h5>
                </div>
                <div class="row">
                    <a class="button" href='/explore'>Explore</a>
                    <a class="button" href='/info'>Info</a>
                </div>
            </div>
            <div class="col">
                <img id="log" src="/img/logo.png" width="280" height="280">
            </div>
        </div>
        <div class="row bottom">
            <%if(locals.user){%>
                <a href='/dashboard'>Logged as <%=locals.user.username%></a>
            <%}else{%>
                <a href='/login'>Login with username</a>
            <%}%>
        </div>
    </div>
    <script src="/js/index.js"></script>
</body>
</html>